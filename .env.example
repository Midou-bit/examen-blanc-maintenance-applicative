# =============================================================================
# Configuration de l'orchestration Docker — COPIER en « .env »
# =============================================================================
#   cp .env.example .env
#
# Ce fichier-ci est versionné (aucune valeur réelle).
# Le fichier .env ne l'est JAMAIS (voir .gitignore).
# -----------------------------------------------------------------------------

# ─── Noms de domaine ─────────────────────────────────────────────────────────
# En local, ajouter ces noms à /etc/hosts (voir scripts/generer-certificats.sh).
# En production, ce sont de vrais sous-domaines pointant vers le serveur.
APP_HOST=app.exam.local
API_HOST=api.exam.local
FRONTEND_URL=https://app.exam.local

# ─── Base de données ─────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
# À générer : openssl rand -base64 24
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=exam_practice_db
# Compte applicatif, à privilèges réduits (voir infra/mongo/init-utilisateur.js)
MONGO_APP_USER=app_user
MONGO_APP_PASSWORD=

# ─── Sécurité applicative ────────────────────────────────────────────────────
# À générer : openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=2h

# ─── Journalisation ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Supervision (docker-compose.monitoring.yml) ─────────────────────────────
GRAFANA_ADMIN_PASSWORD=
