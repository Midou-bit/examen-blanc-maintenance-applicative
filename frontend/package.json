    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "type": "module"
