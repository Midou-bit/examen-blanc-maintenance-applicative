# =============================================================================
# EXEMPLE de configuration frontend — À COPIER en « .env »
# =============================================================================
# Vite n'expose au navigateur QUE les variables préfixées par VITE_
# (Create React App utilisait le préfixe REACT_APP_).
# Ces valeurs finissent dans le JavaScript public : jamais de secret ici.
#
#   cp frontend/.env.example frontend/.env
# -----------------------------------------------------------------------------

# URL de base de l'API selon l'environnement.
# Développement  : http://localhost:5000/api
# Pré-production : https://api.exam.local/api
# Production     : https://api.exemple.fr/api
VITE_API_URL=http://localhost:5000/api
