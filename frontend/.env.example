# =============================================================================
# EXEMPLE de configuration frontend — À COPIER en « .env »
# =============================================================================
# Create React App n'expose au navigateur QUE les variables préfixées
# par REACT_APP_. Ces valeurs finissent dans le bundle JavaScript public :
# ne jamais y mettre de secret.
#
#   cp frontend/.env.example frontend/.env
# -----------------------------------------------------------------------------

# URL de base de l'API selon l'environnement.
# Développement : http://localhost:5000/api
# Pré-production : https://api.preprod.exemple.fr/api
# Production     : https://api.exemple.fr/api
REACT_APP_API_URL=http://localhost:5000/api
