# =============================================================================
# EXEMPLE de configuration backend — À COPIER en « .env » puis À REMPLIR
# =============================================================================
# Ce fichier-ci EST versionné (il ne contient aucune valeur réelle).
# Le fichier .env, lui, ne l'est JAMAIS : voir .gitignore.
#
#   cp backend/.env.example backend/.env
#
# -----------------------------------------------------------------------------

# Environnement d'exécution : development | test | production
# En "production", les cookies passent en Secure (HTTPS obligatoire).
NODE_ENV=development

# Port d'écoute de l'API
PORT=5000

# Chaîne de connexion MongoDB.
# En local  : mongodb://localhost:27017/exam_practice_db
# En Docker : mongodb://mongo:27017/exam_practice_db  (nom du service compose)
MONGO_URI=

# Clé de signature des jetons JWT.
# OBLIGATOIRE : 32 octets aléatoires minimum. À générer avec :
#   openssl rand -hex 32
# Ne jamais réutiliser la même valeur entre développement et production.
JWT_SECRET=

# Durée de validité du jeton de session (format « ms » : 15m, 2h, 7d…)
JWT_EXPIRES_IN=2h

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# Ne JAMAIS mettre « * » : cela autoriserait n'importe quel site.
CORS_ORIGINS=http://localhost:3000

# Niveau de journalisation : error | warn | info | http | debug
LOG_LEVEL=info
